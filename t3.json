{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "logo/kladd-symbol.svg",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "vp install --frozen-lockfile",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Dev",
      "command": "vp run dev",
      "icon": "play",
      "stopOnSettle": true
    },
    {
      "name": "Build App",
      "command": "vp run -r build",
      "icon": "build"
    },
    {
      "name": "Check",
      "command": "vp run check",
      "icon": "test"
    },
    {
      "name": "Package App",
      "command": "vp run @kladd/desktop#package",
      "icon": "build"
    }
  ]
}
